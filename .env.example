# このファイルをコピーして .env を作成し、値を入力してください。
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# グローバル設定にしたい場合は ~/.env.global に同じ形式で記述できます。
# 優先順位: CLI引数 (--api-key / --model) > .env > ~/.env.global > 環境変数 > コード内定数

# --- 必須 ---
# OpenRouter の API キー
# https://openrouter.ai/keys で取得
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI の API キー（タイムスタンプ付き文字起こし用）
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意: 機能ごとの既定モデル ---
# 未設定の場合は src/aitool/models.py の DEFAULT_MODELS が使われます。
# CLI の --model で一時的に上書きも可能です。

# 画像生成 (t2i / i2i)
AITOOL_IMAGE_GENERATION_MODEL=google/gemini-3.1-flash-image-preview

# 画像認識
AITOOL_IMAGE_RECOGNITION_MODEL=google/gemini-3-flash-preview

# 音声文字起こし (STT)
AITOOL_STT_MODEL=openai/whisper-large-v3-turbo

# タイムスタンプ付き文字起こし (OpenAI 直接)
AITOOL_STT_TIMESTAMP_MODEL=whisper-1

# 音声合成 (TTS)
AITOOL_TTS_MODEL=google/gemini-3.1-flash-tts-preview
